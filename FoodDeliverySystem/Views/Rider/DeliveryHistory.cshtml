@model IEnumerable<FoodDeliverySystem.Models.Order>

@{
    ViewData["Title"] = "Delivery History";
}
@{
    var hasSearch = !string.IsNullOrWhiteSpace(ViewBag.Search as string);

    var hasPayment = !string.IsNullOrWhiteSpace(ViewBag.PaymentMethod as string);

    var hasQuick = !string.IsNullOrWhiteSpace(ViewBag.QuickFilter as string);

    var hasDates = ViewBag.FromDate != null || ViewBag.ToDate != null;

    bool showReset = hasSearch || hasPayment || hasQuick || hasDates;
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                📜 Delivery History
            </h2>

            <p class="text-muted mb-0">
                View all completed deliveries and earnings.
            </p>
        </div>

        <span class="badge bg-success fs-6 px-3 py-2">
            @ViewBag.TotalDeliveries Deliveries
        </span>

    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-lg-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center">

                    <div style="font-size:35px;">🚚</div>

                    <h6 class="text-muted mt-2">
                        Deliveries
                    </h6>

                    <h3 class="fw-bold">
                        @ViewBag.TotalDeliveries
                    </h3>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center">

                    <div style="font-size:35px;">💵</div>

                    <h6 class="text-muted mt-2">
                        Cash Orders
                    </h6>

                    <h3 class="text-warning fw-bold">
                        @ViewBag.CashOrders
                    </h3>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center">

                    <div style="font-size:35px;">💳</div>

                    <h6 class="text-muted mt-2">
                        Online Orders
                    </h6>

                    <h3 class="text-primary fw-bold">
                        @ViewBag.OnlineOrders
                    </h3>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center">

                    <div style="font-size:35px;">💰</div>

                    <h6 class="text-muted mt-2">
                        Total Earnings
                    </h6>

                    <h3 class="text-success fw-bold">
                        ₦@Convert.ToDecimal(ViewBag.TotalEarnings).ToString("N0")
                    </h3>

                </div>

            </div>

        </div>

    </div>

    <form method="get"
          asp-action="DeliveryHistory"
          class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row g-3">

                <!-- SEARCH -->

                <div class="col-lg-4">

                    <label class="fw-bold">

                        🔍 Search

                    </label>

                    <input type="text"
                           name="search"
                           class="form-control"
                           placeholder="Customer or Order ID"
                           value="@ViewBag.Search" />

                </div>

                <!-- PAYMENT -->

                <div class="col-lg-3">

                    <label class="fw-bold">

                        💳 Payment

                    </label>

                    <select name="paymentMethod"
                            class="form-select">

                        <option value=""
                                selected="@(string.IsNullOrEmpty(ViewBag.PaymentMethod as string))">

                            All Payments

                        </option>

                        <option value="Cash on Delivery"
                                selected="@(ViewBag.PaymentMethod?.ToString() == "Cash on Delivery")">

                            Cash on Delivery

                        </option>

                        <option value="Pay Online"
                                selected="@(ViewBag.PaymentMethod?.ToString() == "Pay Online")">

                            Pay Online

                        </option>

                    </select>

                </div>

                <!-- QUICK FILTER -->

                <div class="col-lg-3">

                    <label class="fw-bold">

                        📅 Quick Filter

                    </label>

                    <select id="quickFilter"
                            name="quickFilter"
                            class="form-select">

                        <option value=""
                                selected="@(string.IsNullOrEmpty(ViewBag.QuickFilter as string))">

                            All Time

                        </option>

                        <option value="Today"
                                selected="@(ViewBag.QuickFilter?.ToString() == "Today")">

                            Today

                        </option>

                        <option value="ThisWeek"
                                selected="@(ViewBag.QuickFilter?.ToString() == "ThisWeek")">

                            This Week

                        </option>

                        <option value="ThisMonth"
                                selected="@(ViewBag.QuickFilter?.ToString() == "ThisMonth")">

                            This Month

                        </option>

                        <option value="ThisYear"
                                selected="@(ViewBag.QuickFilter?.ToString() == "ThisYear")">

                            This Year

                        </option>

                        <option value="Custom"
                                selected="@(ViewBag.QuickFilter?.ToString() == "Custom")">

                            Custom Range

                        </option>

                    </select>

                </div>

                <!-- SEARCH BUTTON -->

                <div class="col-lg-2 d-grid">

                    <label>&nbsp;</label>

                    <button class="btn btn-primary">

                        🔍 Search

                    </button>

                </div>
                @if (showReset)
                {
                    <div class="col-lg-2 d-grid">

                        <label>&nbsp;</label>

                        <a asp-action="DeliveryHistory"
                           class="btn btn-outline-secondary">

                            🔄 Reset

                        </a>

                    </div>
                }

            </div>

            <!-- CUSTOM RANGE -->

            <div class="row mt-3"
                 id="customDateRow"
                 style="display:none;">

                <div class="col-md-4">

                    <label class="fw-bold">

                        From

                    </label>

                    <input type="date"
                           name="fromDate"
                           class="form-control"
                           value="@ViewBag.FromDate?.ToString("yyyy-MM-dd")" />

                </div>

                <div class="col-md-4">

                    <label class="fw-bold">

                        To

                    </label>

                    <input type="date"
                           name="toDate"
                           class="form-control"
                           value="@ViewBag.ToDate?.ToString("yyyy-MM-dd")" />

                </div>

            </div>

        </div>

    </form>


    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <h3>📦</h3>

                <h4>No Deliveries Yet</h4>

                <p class="text-muted">
                    Completed deliveries will appear here.
                </p>

            </div>

        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <div class="card border-0 shadow-sm mb-4">

                <div class="card-body">

                    <div class="row">

                        <div class="col-lg-9">

                            <div class="d-flex justify-content-between">

                                <h4 class="fw-bold">
                                    Order #@order.Id
                                </h4>

                                <span class="badge bg-success">
                                    ✅ Delivered
                                </span>

                            </div>

                            <hr />

                            <div class="row">

                                <div class="col-md-6">

                                    <p>
                                        <strong>👤 Customer</strong><br />
                                        @order.Customer?.FullName
                                    </p>

                                    <p>
                                        <strong>📞 Phone</strong><br />
                                        <a href="tel:@order.PhoneNumber">
                                            @order.PhoneNumber
                                        </a>
                                    </p>

                                    <p>
                                        <strong>📍 Address</strong><br />
                                        @order.DeliveryAddress
                                    </p>

                                </div>

                                <div class="col-md-6">

                                    <p>
                                        <strong>🏪 Restaurant</strong><br />
                                        @(order.OrderItems.FirstOrDefault()?.FoodItem?.Restaurant?.Name ?? "Unavailable")
                                    </p>

                                    <p>
                                        <strong>💳 Payment</strong><br />
                                        @order.PaymentMethod
                                    </p>

                                    <p>
                                        <strong>💰 Amount</strong><br />
                                        <span class="text-success fw-bold">
                                            ₦@order.TotalAmount.ToString("N0")
                                        </span>
                                    </p>

                                </div>

                            </div>

                            <strong>🍔 Ordered Items</strong>

                            <ul class="mt-2">

                                @foreach (var item in order.OrderItems)
                                {
                                    <li>
                                        @item.FoodItem?.Name
                                        × @item.Quantity
                                    </li>
                                }

                            </ul>

                        </div>

                        <div class="col-lg-3 border-start">

                            <div class="text-center">

                                <h6 class="text-muted">
                                    Delivered On
                                </h6>

                                <h5>
                                    @order.OrderDate.ToString("dd MMM yyyy")
                                </h5>

                                <p class="text-muted">
                                    @order.OrderDate.ToString("hh:mm tt")
                                </p>

                                <a asp-action="Receipt"
                                   asp-route-id="@order.Id"
                                   class="btn btn-success w-100 mt-3">

                                    🧾 View & Print Receipt

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            </div>
        }
    }

</div>

<script>

    const quickFilter = document.getElementById("quickFilter");
    const customRow = document.getElementById("customDateRow");

    const searchInput = document.querySelector('input[name="search"]');
    const paymentSelect = document.querySelector('select[name="paymentMethod"]');
    const fromDate = document.querySelector('input[name="fromDate"]');
    const toDate = document.querySelector('input[name="toDate"]');

    const resetContainer = document.getElementById("resetButtonContainer");

    function toggleDates() {

        if (quickFilter.value === "Custom") {

            customRow.style.display = "flex";

        }
        else {

            customRow.style.display = "none";

        }

    }

    function toggleResetButton() {

        const hasSearch = searchInput.value.trim() !== "";

        const hasPayment = paymentSelect.value !== "";

        const hasQuick = quickFilter.value !== "";

        const hasFrom = fromDate.value !== "";

        const hasTo = toDate.value !== "";

        if (hasSearch || hasPayment || hasQuick || hasFrom || hasTo) {

            resetContainer.style.display = "block";

        }
        else {

            resetContainer.style.display = "none";

        }

    }

    window.onload = function () {

        toggleDates();

        toggleResetButton();

    }

    quickFilter.addEventListener("change", function () {

        toggleDates();

        toggleResetButton();

    });

    searchInput.addEventListener("input", toggleResetButton);

    paymentSelect.addEventListener("change", toggleResetButton);

    fromDate.addEventListener("change", toggleResetButton);

    toDate.addEventListener("change", toggleResetButton);

</script>