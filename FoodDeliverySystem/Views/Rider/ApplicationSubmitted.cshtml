@{
    ViewData["Title"] = "Application Submitted";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow-lg border-0 rounded-4">

                <div class="card-header bg-success text-white text-center">

                    <h2>🎉 Application Submitted Successfully</h2>

                </div>

                <div class="card-body text-center p-5">

                    <h4 class="mb-4">
                        Thank you for applying to become a Delivery Rider.
                    </h4>

                    <p class="lead">
                        Your application has been received successfully.
                    </p>

                    <p>
                        Our administration team will carefully review your application,
                        vehicle information and supporting documents.
                    </p>

                    <div class="alert alert-warning mt-4">

                        <strong>Application Status:</strong>

                        Under Review ⏳

                    </div>

                    <p>
                        You will only be able to access your Rider Dashboard
                        after your application has been approved.
                    </p>

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-primary btn-lg mt-3">

                        🏠 Back to Home

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>