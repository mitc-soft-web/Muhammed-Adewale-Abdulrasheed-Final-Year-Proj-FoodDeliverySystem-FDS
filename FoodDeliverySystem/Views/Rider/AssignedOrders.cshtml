@model List<FoodDeliverySystem.Models.Order>

@{
    ViewData["Title"] = "Assigned Orders";
}

<div class="container py-4">

    <!-- PAGE HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                🚚 Assigned Orders
            </h2>

            <p class="text-muted mb-0">
                Manage today's delivery tasks
            </p>

        </div>

        <span class="badge bg-dark fs-6 px-3 py-2">

            @Model.Count Active Order(s)

        </span>

    </div>


    @if (!Model.Any())
    {
        <div class="card shadow border-0">

            <div class="card-body text-center p-5">

                <h1 class="display-2">
                    🎉
                </h1>

                <h3 class="fw-bold">

                    You're all caught up!

                </h3>

                <p class="text-muted">

                    No assigned deliveries at the moment.

                </p>

            </div>

        </div>
    }
    else
    {

        <div class="row">

            @foreach (var order in Model)
            {

                <div class="col-lg-6 mb-4">

                    <div class="card border-0 shadow-lg h-100"
                         style="border-radius:18px;">

                        <div class="card-body">

                            <!-- HEADER -->

                            <div class="d-flex justify-content-between">

                                <h4 class="fw-bold">

                                    📦 Order #@order.Id

                                </h4>

                                @if (order.Status == "Ready for Pickup")
                                {
                                    <span class="badge bg-warning text-dark fs-6">

                                        Ready

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary fs-6">

                                        On Delivery

                                    </span>
                                }

                            </div>

                            <hr />

                            <!-- CUSTOMER -->

                            <div class="mb-3">

                                <h6 class="text-muted mb-2">

                                    CUSTOMER

                                </h6>

                                <div>

                                    👤 <strong>@order.Customer?.FullName</strong>

                                </div>

                                <div>

                                    📞 @order.PhoneNumber

                                </div>

                                <div>

                                    📍 @order.DeliveryAddress

                                </div>

                            </div>

                            <!-- RESTAURANT -->

                            <div class="mb-3">

                                <h6 class="text-muted mb-2">

                                    RESTAURANT

                                </h6>

                                <div>

                                    🏪
                                    @(order.OrderItems.FirstOrDefault()?.FoodItem?.Restaurant?.Name)

                                </div>

                            </div>

                            <!-- ITEMS -->

                            <div class="mb-3">

                                <h6 class="text-muted mb-2">

                                    ORDER

                                </h6>

                                <span class="badge bg-light text-dark">

                                    🍔 @order.OrderItems.Count Item(s)

                                </span>

                            </div>

                            <!-- PAYMENT -->

                            <div class="mb-3">

                                @if (order.PaymentMethod == "Cash on Delivery")
                                {
                                    <span class="badge bg-warning text-dark me-2">

                                        💵 Cash on Delivery

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success me-2">

                                        💳 Paid Online

                                    </span>
                                }

                                <span class="fw-bold text-success fs-5">

                                    ₦@order.TotalAmount.ToString("N0")

                                </span>

                            </div>

                            <!-- BUTTONS -->

                            <div class="d-grid gap-2 mt-4">

                                @if (order.Status == "Ready for Pickup")
                                {
                                    <a asp-action="AcceptOrder"
                                       asp-route-id="@order.Id"
                                       class="btn btn-success">

                                        🟢 Accept Delivery

                                    </a>
                                }
                                else
                                {
                                    <a asp-action="OrderDetails"
                                       asp-route-id="@order.Id"
                                       class="btn btn-warning">

                                        🚚 Continue Delivery

                                    </a>
                                }

                                <a asp-action="OrderDetails"
                                   asp-route-id="@order.Id"
                                   class="btn btn-outline-primary">

                                    👁 View Details

                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            }

        </div>

    }

</div>