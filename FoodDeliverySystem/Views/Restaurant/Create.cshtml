@model FoodDeliverySystem.ViewModels.RestaurantViewModel

@{
    ViewData["Title"] = "Create Restaurant";
}

<h1>Create Restaurant</h1>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-action="Create"
      method="post"
      enctype="multipart/form-data">

    <div class="mb-3">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Address"></label>
        <input asp-for="Address" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="PhoneNumber"></label>
        <input asp-for="PhoneNumber" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Description"></label>
        <textarea asp-for="Description"
                  class="form-control"></textarea>
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsOpen"
               class="form-check-input" />

        <label asp-for="IsOpen"
               class="form-check-label">
            Restaurant Open
        </label>
    </div>

    <div class="mb-3">

        <label asp-for="LogoFile"
               class="form-label">
            Restaurant Logo
        </label>

        <input asp-for="LogoFile"
               type="file"
               class="form-control"
               accept="image/*" />

    </div>

    <div class="mb-3">

        <label asp-for="CoverImage" class="form-label">

            Cover Image

        </label>

        <input asp-for="CoverImageFile"
               type="file"
               class="form-control"
               accept="image/*" />

    </div>

    <button type="submit"
            class="btn btn-success">
        Save Restaurant
    </button>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}