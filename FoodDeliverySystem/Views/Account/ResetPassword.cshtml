@model FoodDeliverySystem.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="login-page">

    <div class="container">

        <div class="row align-items-center g-4">

            <!-- LEFT SIDE -->

            <div class="col-lg-6 d-flex flex-column justify-content-center align-items-center text-center">

                <img src="~/images/logo-light.png"
                     class="img-fluid login-logo mb-3"
                     style="max-width:280px;"
                     alt="Food Xpress" />

                <h2 class="fw-bold login-title">

                    Create a New Password

                </h2>

                <p class="text-muted login-subtitle">

                    Your new password should be secure and easy for you to remember.

                </p>

                <img src="~/images/login-illustration.png"
                     class="img-fluid login-illustration d-none d-lg-block"
                     alt="Food Xpress" />

            </div>

            <!-- RIGHT SIDE -->

            <div class="col-lg-5 offset-lg-1">

                <div class="card border-0 shadow-lg rounded-4">

                    <div class="card-body p-4">

                        <div class="text-center mb-4">

                            <h2 class="fw-bold">

                                Reset Password

                            </h2>

                            <p class="text-muted">

                                Enter your new password below.

                            </p>

                        </div>

                        <form asp-action="ResetPassword" method="post">

                            <div asp-validation-summary="All"
                                 class="text-danger mb-3"></div>

                            <input asp-for="Token" type="hidden" />
                            <input asp-for="Email" type="hidden" />

                            <!-- PASSWORD -->

                            <div class="mb-3">

                                <label asp-for="Password"
                                       class="form-label fw-semibold"></label>

                                <div class="position-relative">

                                    <i class="bi bi-lock input-icon"></i>

                                    <input asp-for="Password"
                                           id="passwordInput"
                                           class="form-control login-input password-input"
                                           placeholder="Enter new password" />

                                    <i class="bi bi-eye password-toggle"
                                       id="togglePassword"></i>

                                </div>

                            </div>

                            <!-- CONFIRM PASSWORD -->

                            <div class="mb-4">

                                <label asp-for="ConfirmPassword"
                                       class="form-label fw-semibold"></label>

                                <div class="position-relative">

                                    <i class="bi bi-shield-lock input-icon"></i>

                                    <input asp-for="ConfirmPassword"
                                           id="confirmPasswordInput"
                                           class="form-control login-input password-input"
                                           placeholder="Confirm new password" />

                                    <i class="bi bi-eye password-toggle"
                                       id="toggleConfirmPassword"></i>

                                </div>

                            </div>

                            <button type="submit"
                                    class="btn btn-lg w-100 rounded-3 text-white submit-loading-btn"
                                    style="background:linear-gradient(90deg,#ff6b35,#ff9f1c);
                                    border:none;"
                                    onmouseover="this.style.opacity='0.9'"
                                    onmouseout="this.style.opacity='1'"
                                    data-loading="Reseting Password...">

                                <i class="bi bi-key-fill me-2"></i>

                                Reset Password

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />


}
<script src="~/js/email-validation.js"></script>
<script>

    function togglePassword(inputId, iconId){

        const input=document.getElementById(inputId);
        const icon=document.getElementById(iconId);

        icon.addEventListener("click",function(){

            if(input.type==="password"){

                input.type="text";

                icon.classList.replace("bi-eye","bi-eye-slash");

            }else{

                input.type="password";

                icon.classList.replace("bi-eye-slash","bi-eye");

            }

        });

    }

    togglePassword("passwordInput","togglePassword");
    togglePassword("confirmPasswordInput","toggleConfirmPassword");

</script>