@model FoodDeliverySystem.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container py-3 login-page">

    <div class="row align-items-center g-2">

        <!-- LEFT SIDE -->

        <div class="col-lg-6 text-center d-flex flex-column justify-content-center">

            <div class="mb-3">

                <img src="~/images/logo-light.png"
                     class="img-fluid login-logo"
                     alt="Food Xpress" />

            </div>

            <h3 class="fw-bold login-title">

                Forgot Your Password?

            </h3>

            <p class="text-muted login-subtitle">

                Enter your email address and we'll send you instructions to reset your password.

            </p>

            <img src="~/images/login-illustration.png"
                 class="img-fluid login-illustration d-none d-lg-block"
                 alt="Forgot Password" />

        </div>

        <!-- RIGHT SIDE -->

        <div class="col-lg-5 offset-lg-1">

            <div class="card border-0 shadow-lg rounded-4">

                <div class="card-body p-5">

                    <div class="text-center mb-4">

                        <h2 class="fw-bold">

                            Forgot Password

                        </h2>

                        <p class="text-muted">

                            Enter your registered email below.

                        </p>

                    </div>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success">

                            @TempData["Success"]

                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">

                            <i class="bi bi-exclamation-circle me-2"></i>

                            @TempData["Error"]

                        </div>
                    }

                    <form asp-action="ForgotPassword"
                          method="post">

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-4">

                            <label asp-for="Email"
                                   class="form-label fw-semibold"></label>

                            <div class="position-relative">

                                <i class="bi bi-envelope input-icon"></i>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control login-input email-validation"
                                       autocomplete="email"
                                       placeholder="Enter your email address" />

                                <span asp-validation-for="Email"
                                      class="text-danger small"></span>

                            </div>

                        </div>

                        <button type="submit"
                                class="btn btn-lg w-100 rounded-3 text-white submit-loading-btn"
                                style="background:linear-gradient(90deg,#ff6b35,#ff9f1c);
                            border:none;"
                                onmouseover="this.style.opacity='0.9'"
                                onmouseout="this.style.opacity='1'"
                                data-loading="Sending Reset Link Please Wait...">

                            <i class="bi bi-send me-2"></i>

                            Send Reset Link

                        </button>

                    </form>

                    <hr />

                    <div class="text-center">

                        Remember your password?

                        <a asp-action="Login"
                           class="fw-bold text-decoration-none"
                           style="color:#ff6b35;">

                            Login

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/email-validation.js"></script>
}