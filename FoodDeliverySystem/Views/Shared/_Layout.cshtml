@using Microsoft.AspNetCore.Identity
@using FoodDeliverySystem.Models
@using Microsoft.EntityFrameworkCore
@using FoodDeliverySystem.Data
@inject ApplicationDbContext Context
@inject UserManager<ApplicationUser> UserManager
@{
    string adminTheme = "Light";

    if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
    {
        var currentAdmin = await UserManager.GetUserAsync(User);

        if (currentAdmin != null)
        {
            var adminSettings = await Context.AdminSettings
                .FirstOrDefaultAsync(s => s.UserId == currentAdmin.Id);

            if (adminSettings != null &&
                !string.IsNullOrWhiteSpace(adminSettings.Theme))
            {
                adminTheme = adminSettings.Theme;
            }
        }
    }
}

<!-- ==================================================
     ROOT HTML
     ================================================== -->
<!DOCTYPE html>
<html lang="en">

<!-- ==================================================
         HEAD
         ================================================== -->
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Food Xpress</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FoodDeliverySystem.styles.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>

    <!-- ==================================================
             HEADER / NAVBAR
             ================================================== -->
    <div class="admin-theme-wrapper theme-@adminTheme.ToLowerInvariant()">
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom sticky-top shadow">

            <div class="container-fluid px-4">

                <!-- ----------------- Logo ----------------- -->
                <a class="navbar-brand me-4"
                   asp-controller="Home"
                   asp-action="Index">
                    <img src="~/images/nav-logo.png"
                         class="navbar-logo"
                         alt="Food Xpress" />
                </a>

                <!-- ----------------- Mobile Toggler ----------------- -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="navbarNav">

                    <!-- ================= LEFT NAV / ROLE NAV PARTIALS ================= -->
                    <div class="navbar-nav flex-grow-1">

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            if (User.IsInRole("Admin"))
                            {
                                @await Html.PartialAsync("~/Views/Shared/_AdminNav.cshtml")
                            }
                            else if (User.IsInRole("RestaurantOwner"))
                            {
                                @await Html.PartialAsync("~/Views/Shared/_RestaurantNav.cshtml")
                            }
                            else if (User.IsInRole("Rider"))
                            {
                                @await Html.PartialAsync("~/Views/Shared/_RiderNav.cshtml")
                            }
                            else
                            {
                                @await Html.PartialAsync("~/Views/Shared/_CustomerNav.cshtml")
                            }
                        }
                        else
                        {
                            @await Html.PartialAsync("~/Views/Shared/_GuestNav.cshtml")
                        }

                    </div>
                    <!-- ================= END LEFT NAV ================= -->
                    <!-- ================= RIGHT TOOLBAR (ADMIN / USER) ================= -->
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="admin-toolbar ms-lg-auto">

                            <a asp-controller="Admin"
                               asp-action="Notifications"
                               class="admin-nav-btn position-relative">
                                <i class="bi bi-bell"></i>

                                @if (ViewBag.UnreadCount != null && (int)ViewBag.UnreadCount > 0)
                                {
                                    <span class="admin-badge">
                                        @ViewBag.UnreadCount
                                    </span>
                                }
                            </a>

                            <button class="admin-nav-btn"
                                    onclick="document.documentElement.requestFullscreen()">
                                <i class="bi bi-arrows-fullscreen"></i>
                            </button>

                            <div class="dropdown admin-profile-dropdown">
                                <button class="btn admin-profile-btn dropdown-toggle"
                                        data-bs-toggle="dropdown">
                                    @if (User.Identity!.IsAuthenticated)
                                    {
                                        var currentUser = await UserManager.GetUserAsync(User);

                                        if (!string.IsNullOrEmpty(currentUser?.ProfilePicture))
                                        {
                                            <img src="@currentUser.ProfilePicture"
                                                 class="admin-navbar-avatar"
                                                 alt="Profile" />
                                        }
                                        else
                                        {
                                            <i class="bi bi-person-circle"></i>
                                        }

                                        <div class="admin-user">
                                            <strong>
                                                @currentUser.FullName
                                            </strong>
                                            <small>
                                                Administrator
                                            </small>
                                        </div>
                                    }
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4">

                                    @if (User.Identity!.IsAuthenticated)
                                    {
                                        var currentUser = await UserManager.GetUserAsync(User);

                                        <li class="admin-dropdown-header">

                                            @if (!string.IsNullOrEmpty(currentUser?.ProfilePicture))
                                            {
                                                <img src="@currentUser.ProfilePicture"
                                                     class="admin-dropdown-avatar" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-person-circle admin-dropdown-default"></i>
                                            }

                                            <h6>@currentUser?.FullName</h6>

                                            <span>Administrator</span>

                                        </li>

                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>
                                    }

                                    <li>

                                        <a asp-controller="Admin"
                                           asp-action="Profile"
                                           class="dropdown-item">

                                            <i class="bi bi-person me-2"></i>

                                            Profile

                                        </a>

                                    </li>

                                    <li>

                                        <a class="dropdown-item"
                                           asp-controller="Admin"
                                           asp-action="ActivityLog">

                                            <i class="bi bi-clock-history me-2"></i>

                                            Activity Log

                                        </a>

                                    </li>

                                    <li>

                                        <a asp-controller="Admin"
                                           asp-action="Settings"
                                           class="dropdown-item">

                                            <i class="bi bi-gear me-2"></i>

                                            Settings

                                        </a>

                                    </li>

                                    <li>

                                        <hr class="dropdown-divider" />

                                    </li>

                                        <li>
                                            <button type="button"
                                                    class="dropdown-item foodxpress-logout-trigger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#foodXpressLogoutModal"
                                                    data-logout-type="identity">

                                                <i class="bi bi-box-arrow-right me-2"></i>

                                                Logout

                                            </button>
                                        </li>

                                </ul>
                            </div>

                        </div>
                    }
                    else
                    {
                        <!-- ----------------- Search + Login Partial ----------------- -->
                        @if (!User.Identity.IsAuthenticated || User.IsInRole("Customer"))
                        {
                            <div class="nav-search">
                                <form asp-controller="Search"
                                      asp-action="Index"
                                      method="get"
                                      class="search-box">
                                        @Html.AntiForgeryToken()
                                    <i class="bi bi-search search-icon"></i>

                                    <input id="globalSearch"
                                           name="keyword"
                                           class="form-control search-input"
                                           autocomplete="off"
                                           placeholder="Search on Food Xpress..." />
                                </form>

                                <div id="globalSuggestions"
                                     class="search-suggestions">
                                </div>
                            </div>
                        }

                        <partial name="_LoginPartial" />
                    }
                    <!-- ================= END RIGHT TOOLBAR ================= -->

                </div> <!-- /.collapse .navbar-collapse -->

            </div> <!-- /.container-fluid -->

        </nav>
    </header>
    <!-- ==================================================
             END HEADER / NAVBAR
             ================================================== -->
    <!-- ==================================================
             MAIN PAGE CONTAINER
             ================================================== -->
    <div class="container py-5 page-container">

        @RenderBody()

    </div>
    <!-- ==================================================
             END MAIN PAGE CONTAINER
             ================================================== -->
    <!-- ==================================================
             FOOTER
             ================================================== -->
    <footer class="footer-custom">

        <div class="container">

            <div class="row align-items-start">

                <!-- ----------------- LOGO / SLOGAN / SOCIAL ----------------- -->
                <div class="col-lg-4 mb-4">
                    <img src="~/images/nav-logo.png"
                         class="footer-logo"
                         alt="Food Xpress" />

                    <p class="footer-slogan mt-3">
                        Order food from your favourite restaurants<br />
                        anytime, anywhere.
                    </p>

                    <div class="footer-social mt-3">
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-instagram"></i></a>
                        <a href="#"><i class="bi bi-twitter-x"></i></a>
                        <a href="#"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>

                <!-- ----------------- CONTACT ----------------- -->
                <div class="col-lg-3 mb-4">
                    <h5 class="footer-title">
                        Contact
                    </h5>

                    <p>
                        <i class="bi bi-geo-alt-fill me-2"></i>
                        Nigeria
                    </p>

                    <p>
                        <i class="bi bi-telephone-fill me-2"></i>
                        +234 90 632 70762
                    </p>

                    <p>
                        <i class="bi bi-envelope-fill me-2"></i>
                        support@foodxpress.com
                    </p>
                </div>

                <!-- ----------------- BUSINESS HOURS ----------------- -->
                <div class="col-lg-3 mb-4">
                    <h5 class="footer-title">
                        Business Hours
                    </h5>

                    <p>
                        <i class="bi bi-clock-fill me-2"></i>
                        Mon - Sun
                    </p>

                    <p>
                        <i class="bi bi-alarm-fill me-2"></i>
                        8:00 AM - 10:00 PM
                    </p>
                </div>

                <!-- ----------------- QUICK LINKS ----------------- -->
                <div class="col-lg-2 mb-4">
                    <h5 class="footer-title">
                        Quick Links
                    </h5>

                    <p>
                        <a asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house-door-fill me-2"></i>Home
                        </a>
                    </p>

                    <p>
                        <a asp-controller="FoodItem" asp-action="Index">
                            <i class="bi bi-basket-fill me-2"></i>Browse Foods
                        </a>
                    </p>

                    <p>
                        <a asp-controller="Restaurant" asp-action="Index">
                            <i class="bi bi-shop me-2"></i>Restaurants
                        </a>
                    </p>

                    <p>
                        <a asp-controller="Rider" asp-action="Register">
                            <i class="bi bi-bicycle me-2"></i>Become a Rider
                        </a>
                    </p>
                </div>

            </div> <!-- /.row -->

            <hr class="footer-divider" />

            <div class="text-center footer-copy">
                © @DateTime.Now.Year Food Xpress. All Rights Reserved.
            </div>

        </div> <!-- /.container -->

    </footer>
    <!-- ==================================================
             END FOOTER
             ================================================== -->
    <!-- ==================================================
             SCRIPTS
             ================================================== -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/global-search.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

        document.querySelectorAll("form").forEach(function (form) {

        form.addEventListener("submit", function (e) {

        // ASP.NET MVC / jQuery Validation
        if (window.jQuery && $(form).data("validator")) {
        if (!$(form).valid()) {
        return;
        }
        }
        else {
        // HTML5 Validation
        if (!form.checkValidity()) {
        return;
        }
        }

        const btn = form.querySelector(".submit-loading-btn");

        if (!btn)
        return;

        if (btn.disabled)
        return;

        btn.disabled = true;

        const loadingText =
        btn.dataset.loading || "Processing...";

        btn.dataset.original = btn.innerHTML;

        btn.innerHTML =
        '<span class="spinner-border spinner-border-sm me-2"></span>'
        + loadingText;

        });

        });

        });

            document.addEventListener("DOMContentLoaded", function () {

            const logoutModal =
            document.getElementById("foodXpressLogoutModal");

            if (!logoutModal)
            return;

            const accountForm =
            document.getElementById("foodXpressAccountLogoutForm");

            const identityForm =
            document.getElementById("foodXpressIdentityLogoutForm");

            const logoutTriggers =
            document.querySelectorAll("[data-logout-type]");


            // Hide both logout forms initially
            accountForm.style.display = "none";
            identityForm.style.display = "none";


            logoutTriggers.forEach(function (trigger) {

            trigger.addEventListener("click", function () {

            const logoutType =
            trigger.getAttribute("data-logout-type");


            // Hide both buttons first
            accountForm.style.display = "none";
            identityForm.style.display = "none";


            if (logoutType === "identity") {

            // Admin
            identityForm.style.display = "block";

            }
            else if (logoutType === "account") {

            // Customer / Rider / Restaurant Owner
            accountForm.style.display = "block";

            }

            });

            });

            });

    </script>
    <!-- ==================================================
             END SCRIPTS
             ================================================== -->
    <!-- ==================================================
             TOAST MESSAGES
             ================================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="food-toast success">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="food-toast error">
            <i class="bi bi-x-circle-fill"></i>
            @TempData["Error"]
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="food-toast warning">
            <i class="bi bi-exclamation-circle-fill"></i>
            @TempData["Warning"]
        </div>
    }

        <!-- ==================================================
     FOOD XPRESS LOGOUT CONFIRMATION MODAL
     ================================================== -->
        <div class="modal fade"
             id="foodXpressLogoutModal"
             tabindex="-1"
             aria-labelledby="foodXpressLogoutModalLabel"
             aria-hidden="true">

            <div class="modal-dialog modal-dialog-centered">

                <div class="modal-content foodxpress-logout-modal">

                    <!-- Header -->
                    <div class="modal-header foodxpress-logout-header">

                        <div class="foodxpress-logout-icon">
                            <i class="bi bi-box-arrow-right"></i>
                        </div>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>

                    </div>

                    <!-- Body -->
                    <div class="modal-body text-center">

                        <h4 id="foodXpressLogoutModalLabel"
                            class="foodxpress-logout-title">

                            Logout?

                        </h4>

                        <p class="foodxpress-logout-text">

                            Are you sure you want to log out of your
                            <strong>Food Xpress</strong> account?

                        </p>

                    </div>

                    <!-- Footer -->
                    <div class="modal-footer foodxpress-logout-footer">

                        <button type="button"
                                class="btn foodxpress-cancel-btn"
                                data-bs-dismiss="modal">

                            Cancel

                        </button>

                        <div class="foodxpress-logout-actions">

                            <!-- AccountController logout -->
                            <form id="foodXpressAccountLogoutForm"
                                  asp-controller="Account"
                                  asp-action="Logout"
                                  method="get"
                                  class="m-0">

                                <button type="submit"
                                        class="btn foodxpress-confirm-logout-btn">

                                    <i class="bi bi-box-arrow-right me-2"></i>

                                    Yes, Logout

                                </button>

                            </form>


                            <!-- Identity Admin logout -->
                            <form id="foodXpressIdentityLogoutForm"
                                  asp-area="Identity"
                                  asp-page="/Account/Logout"
                                  method="post"
                                  class="m-0">

                                <button type="submit"
                                        class="btn foodxpress-confirm-logout-btn">

                                    <i class="bi bi-box-arrow-right me-2"></i>

                                    Yes, Logout

                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            </div>

        </div>


    @await RenderSectionAsync("Scripts", required: false)

    <div id="toastMessage" class="search-toast"></div>
    </div>
    <!-- ==================================================
             END TOAST MESSAGES
             ================================================== -->

</body>
</html>