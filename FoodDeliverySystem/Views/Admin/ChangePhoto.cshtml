@model FoodDeliverySystem.Models.ApplicationUser

@{
    ViewData["Title"] = "Change Profile Photo";
}

<div class="admin-profile-page">

    <div class="admin-profile-header">

        <div>

            <span class="admin-page-tag">

                <i class="bi bi-camera"></i>

                PROFILE PHOTO

            </span>

            <h1>Change Profile Photo</h1>

            <p>Select a new profile picture.</p>

        </div>

    </div>

    <div class="admin-profile-card">

        <form asp-action="ChangePhoto"
              method="post"
              enctype="multipart/form-data">

            <div class="text-center mb-4">

                <span class="admin-page-tag">

                    <i class="bi bi-person-circle"></i>

                    CURRENT PHOTO

                </span>

                <div class="mt-3">

                    @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                    {
                        <img src="@Model.ProfilePicture"
                             class="admin-photo-preview" />
                    }
                    else
                    {
                        <i class="bi bi-person-circle admin-photo-icon"></i>
                    }

                </div>

            </div>

            <div class="food-upload">

                <input type="file"
                       id="photo"
                       name="photo"
                       accept=".jpg,.jpeg,.png"
                       hidden />

                <label for="photo" class="food-upload-box">

                    <i class="bi bi-cloud-arrow-up-fill"></i>

                    <h4>Choose Profile Picture</h4>

                    <p>

                        Drag & Drop

                        <span>or click to browse</span>

                    </p>

                    <small>

                        JPG • PNG • JPEG

                    </small>

                    <div id="selectedFile">

                        No file selected

                    </div>

                </label>


            </div>

            <div class="d-flex gap-3 mt-4">

                <button type="submit"
                        id="uploadBtn"
                        class="food-btn"
                        disabled>

                    <i class="bi bi-upload"></i>

                    Upload Photo

                </button>

                <a asp-action="Profile"
                   class="food-btn-outline">

                    Cancel

                </a>

            </div>

        </form>

    </div>



    <script>

            const picker = document.getElementById("photo");

            const fileName = document.getElementById("selectedFile");

            const uploadBtn = document.getElementById("uploadBtn");

            picker.addEventListener("change", function () {

                if (this.files.length > 0) {

                    fileName.innerHTML =
                        `<i class="bi bi-check-circle-fill"></i> ${this.files[0].name}`;

                    fileName.classList.add("selected");

                    uploadBtn.disabled = false;

                }
                else {

                    fileName.innerHTML = "No file selected";

                    fileName.classList.remove("selected");

                    uploadBtn.disabled = true;

                }

            });

    </script>

</div>