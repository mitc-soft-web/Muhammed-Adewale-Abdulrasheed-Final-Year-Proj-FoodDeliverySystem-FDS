@model FoodDeliverySystem.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
}

<div class="admin-profile-page">

    <div class="admin-profile-header">

        <div>
            <span class="admin-page-tag">
                <i class="bi bi-shield-lock"></i>
                ACCOUNT SECURITY
            </span>

            <h1>Change Password</h1>

            <p>
                Update your password to keep your administrator account secure.
            </p>
        </div>

    </div>


    <div class="admin-profile-card admin-security-card">

        <div class="admin-security-intro">

            <div class="admin-security-icon">
                <i class="bi bi-shield-check"></i>
            </div>

            <div>
                <h4>Password Security</h4>

                <p>
                    Enter your current password and choose a new secure password.
                </p>
            </div>

        </div>


        <form asp-action="ChangePassword"
              method="post"
              id="changePasswordForm">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-4">
            </div>


            <!-- CURRENT PASSWORD -->

            <div class="admin-form-group">

                <label asp-for="CurrentPassword">
                    <i class="bi bi-lock"></i>
                    Current Password
                </label>

                <div class="admin-password-wrapper">

                    <i class="bi bi-lock admin-password-left-icon"></i>

                    <input asp-for="CurrentPassword"
                           type="password"
                           class="admin-input admin-password-input"
                           placeholder="Enter your current password"
                           autocomplete="current-password" />

                    <button type="button"
                            class="admin-password-toggle"
                            data-target="CurrentPassword"
                            aria-label="Show password">

                        <i class="bi bi-eye"></i>

                    </button>

                </div>

                <span asp-validation-for="CurrentPassword"
                      class="text-danger">
                </span>

            </div>


            <!-- NEW PASSWORD -->

            <div class="admin-form-group">

                <label asp-for="NewPassword">
                    <i class="bi bi-key"></i>
                    New Password
                </label>

                <div class="admin-password-wrapper">

                    <i class="bi bi-key admin-password-left-icon"></i>

                    <input asp-for="NewPassword"
                           type="password"
                           class="admin-input admin-password-input"
                           placeholder="Enter your new password"
                           autocomplete="new-password" />

                    <button type="button"
                            class="admin-password-toggle"
                            data-target="NewPassword"
                            aria-label="Show password">

                        <i class="bi bi-eye"></i>

                    </button>

                </div>

                <span asp-validation-for="NewPassword"
                      class="text-danger">
                </span>

            </div>


            <!-- CONFIRM PASSWORD -->

            <div class="admin-form-group">

                <label asp-for="ConfirmPassword">
                    <i class="bi bi-check2-circle"></i>
                    Confirm New Password
                </label>

                <div class="admin-password-wrapper">

                    <i class="bi bi-check2-circle admin-password-left-icon"></i>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="admin-input admin-password-input"
                           placeholder="Confirm your new password"
                           autocomplete="new-password" />

                    <button type="button"
                            class="admin-password-toggle"
                            data-target="ConfirmPassword"
                            aria-label="Show password">

                        <i class="bi bi-eye"></i>

                    </button>

                </div>

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger">
                </span>

            </div>


            <!-- PASSWORD INFO -->

            <div class="admin-password-requirements">

                <i class="bi bi-info-circle"></i>

                <span>
                    Use at least 6 characters. For better security,
                    use a combination of uppercase letters, lowercase letters,
                    numbers and symbols.
                </span>

            </div>


            <!-- BUTTONS -->

            <div class="admin-security-actions">

                <button type="submit"
                        class="admin-save-btn"
                        id="changePasswordBtn">

                    <span class="admin-btn-text">
                        <i class="bi bi-shield-check"></i>
                        Change Password
                    </span>

                    <span class="admin-btn-loading d-none">

                        <span class="spinner-border spinner-border-sm"
                              role="status"
                              aria-hidden="true">
                        </span>

                        Changing Password...

                    </span>

                </button>


                <a asp-action="Profile"
                   class="admin-cancel-btn">

                    <i class="bi bi-arrow-left"></i>

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            /* ==============================
               PASSWORD EYE TOGGLE
               ============================== */

            document.querySelectorAll(".admin-password-toggle")
                .forEach(function (button) {

                    button.addEventListener("click", function () {

                        const targetId = button.getAttribute("data-target");

                        const input = document.getElementById(targetId);

                        const icon = button.querySelector("i");

                        if (!input) return;

                        if (input.type === "password") {

                            input.type = "text";

                            icon.classList.remove("bi-eye");

                            icon.classList.add("bi-eye-slash");

                            button.setAttribute(
                                "aria-label",
                                "Hide password"
                            );

                        }
                        else {

                            input.type = "password";

                            icon.classList.remove("bi-eye-slash");

                            icon.classList.add("bi-eye");

                            button.setAttribute(
                                "aria-label",
                                "Show password"
                            );

                        }

                    });

                });


            /* ==============================
               SUBMIT SPINNER
               ============================== */

            const form =
                document.getElementById("changePasswordForm");

            const button =
                document.getElementById("changePasswordBtn");

            if (form && button) {

                form.addEventListener("submit", function (event) {

                    /*
                       Don't show spinner when
                       client-side validation fails.
                    */

                    if (!$(form).valid()) {
                        return;
                    }

                    const normalText =
                        button.querySelector(".admin-btn-text");

                    const loadingText =
                        button.querySelector(".admin-btn-loading");

                    button.disabled = true;

                    normalText.classList.add("d-none");

                    loadingText.classList.remove("d-none");

                });

            }

        });

    </script>
}