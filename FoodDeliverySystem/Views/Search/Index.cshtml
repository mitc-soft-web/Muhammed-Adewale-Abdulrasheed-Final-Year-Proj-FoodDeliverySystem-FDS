@model IEnumerable<FoodDeliverySystem.Models.FoodItem>

@{
    ViewData["Title"] = "Search";
}

<div class="page-header mb-5">

    <h2 class="section-title">
        <i class="bi bi-search"></i>
        Search Results
    </h2>

    <p class="section-subtitle">
        Results for
        <strong>"@ViewBag.Keyword"</strong>
    </p>

</div>

@if (!Model.Any())
{
    <div class="search-empty-state text-center">

        <i class="bi bi-search display-4"></i>

        <h3 class="mt-3">
            No results found
        </h3>

        <p>
            Try searching by
            food name,
            restaurant,
            category,
            or description.
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-dark rounded-pill px-4 mt-3">

            Back Home

        </a>

    </div>
}
else
{
    <div class="row g-4">

        @foreach (var item in Model)
        {
            <div class="col-xl-4 col-lg-6">

                <div class="restaurant-food-card h-100">

                    <div class="restaurant-food-image">

                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="@item.Name" />
                        }
                        else
                        {
                            <img src="/images/hero.jpg" />
                        }

                        @if (item.IsAvailable)
                        {
                            <span class="restaurant-status available">

                                <i class="bi bi-check-circle-fill"></i>

                                Available

                            </span>
                        }
                        else
                        {
                            <span class="restaurant-status unavailable">

                                <i class="bi bi-x-circle-fill"></i>

                                Unavailable

                            </span>
                        }

                    </div>

                    <div class="restaurant-food-body">

                        <div class="food-top">

                            <h4>@item.Name</h4>

                            <div class="food-price">
                                ₦@item.Price.ToString("N0")
                            </div>

                        </div>

                        <div class="food-tags">

                            <span class="food-category">

                                @item.FoodCategory?.Name

                            </span>

                            <span class="restaurant-name">

                                <i class="bi bi-shop"></i>

                                @item.Restaurant?.Name

                            </span>

                        </div>

                        <p class="food-desc">

                            @item.Description

                        </p>

                        <div class="food-bottom">

                            @if (!item.Restaurant!.IsOpen)
                            {
                                <button class="btn-food disabled" disabled>

                                    Restaurant Closed

                                </button>
                            }
                            else if (!item.IsAvailable)
                            {
                                <button class="btn-food disabled" disabled>

                                    Food Unavailable

                                </button>
                            }
                            else if (User.IsInRole("Customer"))
                            {
                                <a asp-controller="Cart"
                                   asp-action="AddToCart"
                                   asp-route-foodId="@item.Id"
                                   class="btn-food">

                                    <i class="bi bi-cart-plus"></i>

                                    Add to Cart

                                </a>
                            }
                            else
                            {
                                <a asp-controller="Account"
                                   asp-action="Login"
                                   class="btn-food">

                                    <i class="bi bi-box-arrow-in-right"></i>

                                    Login to Order

                                </a>
                            }

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>
}