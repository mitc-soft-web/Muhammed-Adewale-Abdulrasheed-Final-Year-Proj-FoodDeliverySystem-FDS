@model FoodDeliverySystem.Models.Cart

@{
    ViewData["Title"] = "My Cart";
}

<div class="container">

    <h2 class="fw-bold mb-4">
        🛒 My Shopping Cart
    </h2>

    @if (Model == null || !Model.CartItems.Any())
    {
        <div class="text-center py-5">

            <img src="/images/hero.jpg"
                 style="max-width:250px"
                 class="mb-4 rounded">

            <h3>Your cart is empty</h3>

            <p class="text-muted">
                Add some delicious meals to get started.
            </p>

            <a asp-controller="FoodItem"
               asp-action="Index"
               class="btn btn-warning btn-lg">

                🍔 Browse Food

            </a>

        </div>
    }
    else
    {
        decimal subtotal = 0;
        decimal deliveryFee = 1000;

        @foreach (var item in Model.CartItems)
        {
            decimal itemTotal = item.Quantity * item.FoodItem.Price;

            subtotal += itemTotal;

            <div class="card shadow border-0 mb-4">

                <div class="row g-0">

                    <div class="col-md-3">

                        @if (!string.IsNullOrEmpty(item.FoodItem.ImageUrl))
                        {
                            <img src="@item.FoodItem.ImageUrl"
                                 class="img-fluid rounded-start w-100"
                                 style="height:220px;object-fit:cover;">
                        }
                        else
                        {
                            <img src="/images/hero.jpg"
                                 class="img-fluid rounded-start w-100"
                                 style="height:220px;object-fit:cover;">
                        }

                    </div>

                    <div class="col-md-9">

                        <div class="card-body">

                            <h3 class="fw-bold">
                                @item.FoodItem.Name
                            </h3>

                            <h5 class="text-success">
                                ₦@item.FoodItem.Price.ToString("N0")
                            </h5>

                            <div class="d-flex align-items-center mb-3"> <a asp-controller="Cart" asp-action="DecreaseQuantity" asp-route-id="@item.Id" class="btn btn-outline-danger"> − </a> <span class="mx-3 fw-bold fs-5"> @item.Quantity </span> <a asp-controller="Cart" asp-action="IncreaseQuantity" asp-route-id="@item.Id" class="btn btn-outline-success"> + </a> <a asp-controller="Cart" asp-action="RemoveItem" asp-route-id="@item.Id" class="btn btn-danger ms-4"> 🗑 Remove </a> </div>

                            <h4 class="text-danger">
                                Total:
                                ₦@itemTotal.ToString("N0")
                            </h4>

                        </div>

                    </div>

                </div>

            </div>
        }

        decimal grandTotal = subtotal + deliveryFee;

        <div class="card shadow-lg border-0">

            <div class="card-body">

                <h3 class="fw-bold mb-4">
                    Order Summary
                </h3>

                <div class="d-flex justify-content-between">

                    <h5>Subtotal</h5>

                    <h5>₦@subtotal.ToString("N0")</h5>

                </div>

                <div class="d-flex justify-content-between">

                    <h5>Delivery Fee</h5>

                    <h5>₦@deliveryFee.ToString("N0")</h5>

                </div>

                <hr>

                <div class="d-flex justify-content-between">

                    <h3>Grand Total</h3>

                    <h3 class="text-success">
                        ₦@grandTotal.ToString("N0")
                    </h3>

                </div>

                <a asp-controller="Cart" asp-action="Checkout" class="btn btn-success btn-lg w-100 mt-4"> ✅ Proceed to Checkout </a>

            </div>

        </div>
    }

</div>