@model FoodDeliverySystem.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<div class="container mt-5">

    <h2 class="mb-4">
        🛒 Checkout
    </h2>

    <form asp-action="Checkout" method="post">

        <div class="row">

            <!-- LEFT SIDE -->
            <div class="col-lg-7">

                <div class="card shadow mb-4">

                    <div class="card-header bg-primary text-white">
                        Delivery Information
                    </div>

                    <div class="card-body">

                        <div class="mb-3">
                            <label asp-for="DeliveryAddress" class="form-label"></label>
                            <textarea asp-for="DeliveryAddress"
                                      class="form-control"
                                      rows="3"></textarea>
                            <span asp-validation-for="DeliveryAddress"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber"
                                   class="form-control" />
                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OrderNote" class="form-label"></label>
                            <textarea asp-for="OrderNote"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Extra instructions..."></textarea>
                        </div>

                    </div>

                </div>

                <div class="card shadow">

                    <div class="card-header bg-success text-white">
                        Payment Method
                    </div>

                    <div class="card-body">

                        @foreach (var method in Model.PaymentMethods)
                        {
                            <div class="form-check mb-3">

                                <input class="form-check-input"
                                       type="radio"
                                       asp-for="PaymentMethod"
                                       value="@method" />

                                <label class="form-check-label">

                                    @if (method == "Cash on Delivery")
                                    {
                                        <span>💵 @method</span>
                                    }
                                    else if (method == "Pay Online")
                                    {
                                        <span>🌐 @method (Paystack)</span>
                                    }

                                </label>

                            </div>
                        }

                    </div>

                </div>

            </div>

            <!-- RIGHT SIDE -->
            <div class="col-lg-5">

                <div class="card shadow">

                    <div class="card-header bg-dark text-white">
                        Order Summary
                    </div>

                    <div class="card-body">

                        <p class="text-muted">

                            Your selected food items will be processed after you place your order.

                        </p>

                        <hr />

                        <h5>
                            Payment Options
                        </h5>

                        <ul>

                            <li>💵 Cash on Delivery</li>
                            <li>🌐 Pay Online (Paystack)</li>

                        </ul>

                        <hr />

                        <button type="submit"
                                class="btn btn-success w-100 btn-lg">

                            ✅ Place Order

                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary w-100 mt-3">

                            ← Back to Cart

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}